{
  "name": "pi-gentic",
  "version": "0.4.0",
  "type": "module",
  "description": "Pi extension for orchestrating durable agent sessions, delegation, and worktrees.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodeByPeete/pi-gentic.git"
  },
  "homepage": "https://github.com/CodeByPeete/pi-gentic#readme",
  "bugs": {
    "url": "https://github.com/CodeByPeete/pi-gentic/issues"
  },
  "keywords": [
    "pi-package",
    "pi",
    "pi-extension",
    "agents",
    "orchestration",
    "session-management",
    "worktrees"
  ],
  "files": [
    "dist",
    "docs/assets",
    "docs/effect-feature-ledger.md",
    "README.md"
  ],
  "exports": "./dist/extension.js",
  "types": "./dist/extension.d.ts",
  "pi": {
    "extensions": [
      "./dist/extension.js"
    ],
    "image": "https://raw.githubusercontent.com/CodeByPeete/pi-gentic/main/docs/assets/resume.png"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.js\" \"test-effect/**/*.ts\" \"test-ui/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.js\" \"test-effect/**/*.ts\" \"test-ui/**/*.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:effect": "effect-tsgo diagnostics --project tsconfig.json --strict --format pretty",
    "check": "npm run typecheck && npm run check:effect && npm test && npm run pack:dry",
    "test": "npm run test:unit && npm run test:effect",
    "test:unit": "npm run build && node --test test/*.test.js",
    "test:effect": "vitest run",
    "test:integration": "npm run build && node --test test/config-trust.test.js test/worktree-security.test.js",
    "test:compat": "npm run build && node --test test/active-agent-calls.test.js test/live-runtime.test.js test/resume.test.js",
    "test:coverage": "npm run build && node --experimental-test-coverage --test-coverage-lines=95 --test-coverage-functions=93 --test-coverage-branches=80 --test-coverage-include=dist/**/*.js --test-coverage-exclude=dist/domain/** --test-coverage-exclude=dist/infrastructure/pi/** --test-coverage-exclude=dist/infrastructure/runtime/** --test-coverage-exclude=dist/runtime/** --test-coverage-exclude=dist/ui.js --test test/*.test.js",
    "test:coverage:effect": "vitest run --coverage",
    "test:ui": "npm run build && node test-ui/capture-ui.mjs",
    "test:e2e": "npm run build && python test-e2e/capture-terminal-ui.py --deterministic",
    "test:e2e:live": "npm run build && python test-e2e/capture-terminal-ui.py",
    "prepare": "sh ./scripts/prepare-effect.sh",
    "prepack": "npm run build",
    "pack:dry": "npm pack --dry-run"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0",
    "@effect/tsgo": "0.24.3",
    "@effect/vitest": "4.0.0-beta.101",
    "@types/node": "25.9.3",
    "@vitest/coverage-v8": "4.1.10",
    "prettier": "3.8.2",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@earendil-works/pi-tui": "0.83.0"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.101",
    "effect": "4.0.0-beta.101"
  }
}
