{
  "compilerOptions": {
    "target": "ESNext",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ESNext"],
    "types": ["node"],
    "rootDir": "src",
    "outDir": "dist",
    "declaration": true,
    "strict": true,
    "noImplicitAny": true,
    "useUnknownInCatchVariables": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": false,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noPropertyAccessFromIndexSignature": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitOverride": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "refactors": true,
        "diagnostics": true,
        "includeSuggestionsInTsc": true,
        "ignoreEffectSuggestionsInTscExitCode": true,
        "ignoreEffectWarningsInTscExitCode": false,
        "ignoreEffectErrorsInTscExitCode": false,
        "diagnosticSeverity": {
          "anyUnknownInErrorContext": "error",
          "floatingEffect": "error",
          "strictEffectProvide": "warning",
          "tryCatchInEffectGen": "warning",
          "unsafeEffectTypeAssertion": "error"
        },
        "overrides": [
          {
            "include": ["src/**/*.ts"],
            "exclude": [
              "src/agents/activation.ts",
              "src/agents/prompts.ts",
              "src/agents/tool.ts",
              "src/agents/skills.ts",
              "src/delegation/activity.ts",
              "src/delegation/delivery.ts",
              "src/delegation/runs.ts",
              "src/delegation/send.ts",
              "src/extension.ts",
              "src/pi/**/*.ts",
              "src/sessions/catalog.ts",
              "src/sessions/discovery.ts",
              "src/sessions/manage.ts",
              "src/settings.ts",
              "src/shared/**/*.ts",
              "src/ui/**/*.ts"
            ],
            "options": {
              "diagnosticSeverity": {
                "asyncFunction": "warning",
                "cryptoRandomUUID": "warning",
                "cryptoRandomUUIDInEffect": "warning",
                "extendsNativeError": "warning",
                "globalConsole": "warning",
                "globalConsoleInEffect": "warning",
                "globalDate": "warning",
                "globalDateInEffect": "warning",
                "globalFetch": "warning",
                "globalFetchInEffect": "warning",
                "globalRandom": "warning",
                "globalRandomInEffect": "warning",
                "globalTimers": "warning",
                "globalTimersInEffect": "warning",
                "instanceOfSchema": "warning",
                "newPromise": "warning",
                "nodeBuiltinImport": "warning",
                "preferSchemaOverJson": "warning",
                "processEnv": "warning",
                "processEnvInEffect": "warning",
                "unsafeEffectTypeAssertion": "error"
              }
            }
          }
        ]
      }
    ]
  },
  "include": ["src/**/*.ts"]
}
